# Required database connection (MySQL 8+)
DATABASE_URL=mysql+pymysql://www_user:change-me@127.0.0.1:3306/www_financial?charset=utf8mb4

# Optional connection tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Comma-separated frontend origins allowed to send credentialed requests
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External service credentials
BANKINGS_KEY=
CURRENCIES_KEY=
STOCKS_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
CHATS_KEY=
RESEND_API_KEY=
